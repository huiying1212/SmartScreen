<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Checked: clearly highlighted -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/time_slot_radius" />
            <solid android:color="@color/button_primary_bg" />
        </shape>
    </item>

    <!-- Default -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/time_slot_radius" />
            <solid android:color="@color/time_slot_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/input_stroke" />
        </shape>
    </item>
</selector>
