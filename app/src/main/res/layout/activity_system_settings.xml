<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/launcher_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <!-- 顶部栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textColor="#9594c4"
                android:textSize="20sp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="系统设置"
                android:textColor="@color/launcher_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginEnd="36dp" />
        </LinearLayout>

        <!-- 数据收集权限控制 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/launcher_button_bg"
            android:padding="18dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="16dp"
                    android:background="#c3c2f2"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="数据收集权限控制"
                    android:textColor="@color/launcher_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="细粒度控制系统收集哪些数据用于 AI 分析"
                android:textColor="@color/launcher_text_secondary"
                android:textSize="12sp"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="14dp" />

            <!-- 位置信息 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="位置信息"
                        android:textColor="@color/launcher_text_primary"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GPS 定位数据，用于推断使用场景"
                        android:textColor="@color/launcher_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
                <Switch
                    android:id="@+id/switch_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="12dp" />

            <!-- 活动识别 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="活动识别"
                        android:textColor="@color/launcher_text_primary"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="传感器活动分类（步行、静止等）"
                        android:textColor="@color/launcher_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
                <Switch
                    android:id="@+id/switch_activity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="12dp" />

            <!-- 屏幕使用 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="屏幕使用统计"
                        android:textColor="@color/launcher_text_primary"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="应用使用时长、解锁次数、前台应用"
                        android:textColor="@color/launcher_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
                <Switch
                    android:id="@+id/switch_screen_usage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="12dp" />

            <!-- 日历信息 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="日历信息"
                        android:textColor="@color/launcher_text_primary"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="日程事件，用于提供上下文提醒"
                        android:textColor="@color/launcher_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
                <Switch
                    android:id="@+id/switch_calendar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

        </LinearLayout>

        <!-- 系统权限 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/launcher_button_bg"
            android:padding="18dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="16dp"
                    android:background="#c3c2f2"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="系统权限"
                    android:textColor="@color/launcher_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_perm_overlay"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="授权悬浮窗权限"
                android:textSize="13sp"
                android:textColor="@color/button_secondary_text"
                android:backgroundTint="@color/button_secondary_bg"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_perm_usage"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="授权使用情况访问"
                android:textSize="13sp"
                android:textColor="@color/button_secondary_text"
                android:backgroundTint="@color/button_secondary_bg"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_start_collection"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="启动数据收集服务"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#9594c4" />
        </LinearLayout>

        <!-- 屏幕使用历史 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/launcher_button_bg"
            android:padding="18dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="16dp"
                    android:background="#c3c2f2"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="屏幕使用历史"
                    android:textColor="@color/launcher_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="每天生成的壁纸记录"
                android:textColor="@color/launcher_text_secondary"
                android:textSize="12sp"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:id="@+id/history_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- 测试入口 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/launcher_button_bg"
            android:padding="18dp"
            android:layout_marginBottom="48dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="16dp"
                    android:background="#c3c2f2"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="开发者测试"
                    android:textColor="@color/launcher_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="调试功能和 Prompt 结构查看"
                android:textColor="@color/launcher_text_secondary"
                android:textSize="12sp"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btn_test_data"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="获取当前收集数据"
                android:textSize="13sp"
                android:textColor="@color/button_secondary_text"
                android:backgroundTint="@color/button_secondary_bg"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btn_test_ai"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="测试 AI 提醒功能"
                android:textSize="13sp"
                android:textColor="@color/button_secondary_text"
                android:backgroundTint="@color/button_secondary_bg"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btn_test_wallpaper"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="测试壁纸生成功能"
                android:textSize="13sp"
                android:textColor="@color/button_secondary_text"
                android:backgroundTint="@color/button_secondary_bg"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_generation_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/launcher_text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btn_test_bubble_prompt"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="查看图标提醒 Prompt 结构"
                android:textSize="13sp"
                android:textColor="@color/button_secondary_text"
                android:backgroundTint="@color/button_secondary_bg"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btn_test_wallpaper_prompt"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="查看壁纸生成 Prompt 结构"
                android:textSize="13sp"
                android:textColor="@color/button_secondary_text"
                android:backgroundTint="@color/button_secondary_bg"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btn_test_mood_score"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="查看 MoodScore 各维度"
                android:textSize="13sp"
                android:textColor="@color/button_secondary_text"
                android:backgroundTint="@color/button_secondary_bg"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_test_output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#5C5A8A"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:background="@color/input_bg"
                android:padding="12dp"
                android:textIsSelectable="true"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
