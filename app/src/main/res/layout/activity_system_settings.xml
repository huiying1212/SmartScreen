<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/launcher_background">

    <!-- 固定顶部栏 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingStart="@dimen/spacing_xl"
        android:paddingEnd="@dimen/spacing_xl"
        android:layout_marginTop="@dimen/spacing_lg"
        android:layout_marginBottom="@dimen/spacing_lg">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/back_button_ripple"
            android:contentDescription="返回"
            android:scaleType="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="系统设置"
            android:textColor="@color/launcher_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_xl"
            android:paddingEnd="@dimen/spacing_xl"
            android:paddingBottom="32dp">

        <!-- ══════ 数据收集权限控制 ══════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/launcher_button_bg"
            android:padding="@dimen/card_padding"
            android:elevation="@dimen/card_elevation"
            android:layout_marginBottom="@dimen/card_margin_bottom">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_xs">

                <View
                    android:layout_width="@dimen/section_indicator_width"
                    android:layout_height="@dimen/section_indicator_height"
                    android:background="@drawable/section_indicator"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="上下文采集权限"
                    android:textColor="@color/launcher_text_primary"
                    android:textSize="@dimen/text_section_title"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="控制 RI4SU 采集哪些上下文信息用于反思分析"
                android:textColor="@color/launcher_text_secondary"
                android:textSize="@dimen/text_caption"
                android:layout_marginStart="13dp"
                android:layout_marginBottom="@dimen/spacing_lg" />

            <!-- 位置信息 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:layout_marginBottom="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="@dimen/spacing_md">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="位置"
                        android:textColor="@color/launcher_text_primary"
                        android:textSize="@dimen/text_body" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GPS 定位，用于推断使用场景"
                        android:textColor="@color/launcher_text_secondary"
                        android:textSize="@dimen/text_small"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
                <Switch
                    android:id="@+id/switch_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="@dimen/spacing_md" />

            <!-- 活动识别 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:layout_marginBottom="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="@dimen/spacing_md">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="活动识别"
                        android:textColor="@color/launcher_text_primary"
                        android:textSize="@dimen/text_body" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="传感器活动分类（步行、静止等）"
                        android:textColor="@color/launcher_text_secondary"
                        android:textSize="@dimen/text_small"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
                <Switch
                    android:id="@+id/switch_activity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="@dimen/spacing_md" />

            <!-- 屏幕使用 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:layout_marginBottom="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="@dimen/spacing_md">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="屏幕使用统计"
                        android:textColor="@color/launcher_text_primary"
                        android:textSize="@dimen/text_body" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="应用使用时长、解锁次数、前台应用"
                        android:textColor="@color/launcher_text_secondary"
                        android:textSize="@dimen/text_small"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
                <Switch
                    android:id="@+id/switch_screen_usage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="@dimen/spacing_md" />

            <!-- 日历信息 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:layout_marginBottom="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="@dimen/spacing_md">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="日历"
                        android:textColor="@color/launcher_text_primary"
                        android:textSize="@dimen/text_body" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="日程事件"
                        android:textColor="@color/launcher_text_secondary"
                        android:textSize="@dimen/text_small"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
                <Switch
                    android:id="@+id/switch_calendar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="@dimen/spacing_md" />

            <!-- WiFi 信息 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:layout_marginBottom="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="@dimen/spacing_md">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WiFi"
                        android:textColor="@color/launcher_text_primary"
                        android:textSize="@dimen/text_body" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="已连接 WiFi 的 SSID 和信号强度"
                        android:textColor="@color/launcher_text_secondary"
                        android:textSize="@dimen/text_small"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
                <Switch
                    android:id="@+id/switch_wifi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="@dimen/spacing_md" />

            <!-- 蓝牙设备 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:layout_marginBottom="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="@dimen/spacing_md">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="蓝牙设备"
                        android:textColor="@color/launcher_text_primary"
                        android:textSize="@dimen/text_body" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="已连接蓝牙设备的名称和类型"
                        android:textColor="@color/launcher_text_secondary"
                        android:textSize="@dimen/text_small"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
                <Switch
                    android:id="@+id/switch_bluetooth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

        </LinearLayout>

        <!-- ══════ 服务控制 ══════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/launcher_button_bg"
            android:padding="@dimen/card_padding"
            android:elevation="@dimen/card_elevation"
            android:layout_marginBottom="@dimen/card_margin_bottom">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_lg">

                <View
                    android:layout_width="@dimen/section_indicator_width"
                    android:layout_height="@dimen/section_indicator_height"
                    android:background="@drawable/section_indicator"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="服务控制"
                    android:textColor="@color/launcher_text_primary"
                    android:textSize="@dimen/text_section_title"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_start_collection"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="启动 RI4SU 服务"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:background="@drawable/button_primary_bg"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- ══════ 屏幕使用历史 ══════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/launcher_button_bg"
            android:padding="@dimen/card_padding"
            android:elevation="@dimen/card_elevation"
            android:layout_marginBottom="@dimen/card_margin_bottom">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_xs">

                <View
                    android:layout_width="@dimen/section_indicator_width"
                    android:layout_height="@dimen/section_indicator_height"
                    android:background="@drawable/section_indicator"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="反思壁纸历史"
                    android:textColor="@color/launcher_text_primary"
                    android:textSize="@dimen/text_section_title"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="每天生成的反思壁纸记录"
                android:textColor="@color/launcher_text_secondary"
                android:textSize="@dimen/text_caption"
                android:layout_marginStart="13dp"
                android:layout_marginBottom="@dimen/spacing_md" />

            <LinearLayout
                android:id="@+id/history_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- ══════ 开发者测试（默认折叠，需密码解锁） ══════ -->
        <LinearLayout
            android:id="@+id/dev_test_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/launcher_button_bg"
            android:padding="@dimen/card_padding"
            android:elevation="@dimen/card_elevation"
            android:layout_marginBottom="48dp">

            <LinearLayout
                android:id="@+id/dev_test_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_xs"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:layout_width="@dimen/section_indicator_width"
                    android:layout_height="@dimen/section_indicator_height"
                    android:background="@drawable/section_indicator"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="开发者测试"
                    android:textColor="@color/launcher_text_primary"
                    android:textSize="@dimen/text_section_title"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_dev_test_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="已折叠"
                    android:textColor="@color/launcher_text_secondary"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="调试功能和 Prompt 结构查看"
                android:textColor="@color/launcher_text_secondary"
                android:textSize="@dimen/text_caption"
                android:layout_marginStart="13dp"
                android:layout_marginBottom="@dimen/spacing_md" />

            <!-- 解锁区（内联输入，不弹窗） -->
            <LinearLayout
                android:id="@+id/dev_test_unlock_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/spacing_md"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/et_dev_test_password"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:hint="输入密码解锁"
                        android:inputType="numberPassword"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textSize="12sp"
                        android:paddingStart="@dimen/spacing_md"
                        android:paddingEnd="@dimen/spacing_md"
                        android:background="@drawable/input_bg_rounded"
                        android:textColor="@color/launcher_text_primary"
                        android:textColorHint="@color/launcher_text_secondary" />

                    <Button
                        android:id="@+id/btn_dev_test_unlock"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:text="解锁"
                        android:textSize="12sp"
                        android:textColor="@color/button_secondary_text"
                        android:background="@drawable/button_secondary_bg"
                        android:stateListAnimator="@null"
                        android:layout_marginStart="@dimen/spacing_sm" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_dev_test_unlock_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FF5252"
                    android:textSize="11sp"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 内容区：默认隐藏，解锁后可展开/折叠 -->
            <LinearLayout
                android:id="@+id/dev_test_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <Button
                android:id="@+id/btn_test_data"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="获取当前上下文数据"
                android:textSize="13sp"
                android:textColor="@color/button_secondary_text"
                android:background="@drawable/button_secondary_bg"
                android:stateListAnimator="@null"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <Button
                android:id="@+id/btn_test_ai"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="测试 AI 反思提醒"
                android:textSize="13sp"
                android:textColor="@color/button_secondary_text"
                android:background="@drawable/button_secondary_bg"
                android:stateListAnimator="@null"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <Button
                android:id="@+id/btn_test_wallpaper"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="测试反思壁纸生成"
                android:textSize="13sp"
                android:textColor="@color/button_secondary_text"
                android:background="@drawable/button_secondary_bg"
                android:stateListAnimator="@null"
                android:layout_marginBottom="@dimen/spacing_xs" />

            <Button
                android:id="@+id/btn_test_esm"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="立即弹出 ESM 问卷（测试）"
                android:textSize="13sp"
                android:textColor="@color/button_secondary_text"
                android:background="@drawable/button_secondary_bg"
                android:stateListAnimator="@null"
                android:layout_marginBottom="@dimen/spacing_xs" />

            <Button
                android:id="@+id/btn_preview_initial_wallpaper"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="预览初始占位壁纸"
                android:textSize="13sp"
                android:textColor="@color/button_secondary_text"
                android:background="@drawable/button_secondary_bg"
                android:stateListAnimator="@null"
                android:layout_marginBottom="@dimen/spacing_xs" />

            <TextView
                android:id="@+id/tv_generation_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/launcher_text_secondary"
                android:textSize="@dimen/text_caption"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <Button
                android:id="@+id/btn_test_bubble_prompt"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="查看反思提醒 Prompt 结构"
                android:textSize="13sp"
                android:textColor="@color/button_secondary_text"
                android:background="@drawable/button_secondary_bg"
                android:stateListAnimator="@null"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <Button
                android:id="@+id/btn_test_wallpaper_prompt"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="查看反思壁纸 Prompt 结构"
                android:textSize="13sp"
                android:textColor="@color/button_secondary_text"
                android:background="@drawable/button_secondary_bg"
                android:stateListAnimator="@null"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <Button
                android:id="@+id/btn_test_score_prompt"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="查看 LLM 评分 Prompt 结构"
                android:textSize="13sp"
                android:textColor="@color/button_secondary_text"
                android:background="@drawable/button_secondary_bg"
                android:stateListAnimator="@null"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <TextView
                android:id="@+id/tv_test_output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#5C5A8A"
                android:textSize="@dimen/text_small"
                android:fontFamily="monospace"
                android:background="@drawable/input_bg_rounded"
                android:padding="@dimen/spacing_md"
                android:textIsSelectable="true"
                android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>

</LinearLayout>
