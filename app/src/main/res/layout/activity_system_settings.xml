<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/launcher_background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_xl"
        android:paddingTop="@dimen/spacing_lg"
        android:paddingBottom="32dp">

        <!-- 顶部栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_xxl">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="←"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="18sp"
                android:gravity="center"
                android:background="@drawable/button_secondary_bg" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="系统设置"
                android:textColor="@color/launcher_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginEnd="36dp" />
        </LinearLayout>

        <!-- ══════ 数据收集权限控制 ══════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/launcher_button_bg"
            android:padding="@dimen/card_padding"
            android:elevation="@dimen/card_elevation"
            android:layout_marginBottom="@dimen/card_margin_bottom">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_xs">

                <View
                    android:layout_width="@dimen/section_indicator_width"
                    android:layout_height="@dimen/section_indicator_height"
                    android:background="@drawable/section_indicator"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="上下文采集权限"
                    android:textColor="@color/launcher_text_primary"
                    android:textSize="@dimen/text_section_title"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="控制 RI4SU 采集哪些上下文信息用于反思分析"
                android:textColor="@color/launcher_text_secondary"
                android:textSize="@dimen/text_caption"
                android:layout_marginStart="13dp"
                android:layout_marginBottom="@dimen/spacing_lg" />

            <!-- 位置信息 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:layout_marginBottom="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="@dimen/spacing_md">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="位置信息"
                        android:textColor="@color/launcher_text_primary"
                        android:textSize="@dimen/text_body" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GPS 定位，用于推断使用场景"
                        android:textColor="@color/launcher_text_secondary"
                        android:textSize="@dimen/text_small"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
                <Switch
                    android:id="@+id/switch_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="@dimen/spacing_md" />

            <!-- 活动识别 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:layout_marginBottom="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="@dimen/spacing_md">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="活动识别"
                        android:textColor="@color/launcher_text_primary"
                        android:textSize="@dimen/text_body" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="传感器活动分类（步行、静止等）"
                        android:textColor="@color/launcher_text_secondary"
                        android:textSize="@dimen/text_small"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
                <Switch
                    android:id="@+id/switch_activity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="@dimen/spacing_md" />

            <!-- 屏幕使用 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:layout_marginBottom="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="@dimen/spacing_md">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="屏幕使用统计"
                        android:textColor="@color/launcher_text_primary"
                        android:textSize="@dimen/text_body" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="应用使用时长、解锁次数、前台应用"
                        android:textColor="@color/launcher_text_secondary"
                        android:textSize="@dimen/text_small"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
                <Switch
                    android:id="@+id/switch_screen_usage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="@dimen/spacing_md" />

            <!-- 日历信息 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="48dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="@dimen/spacing_md">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="日历信息"
                        android:textColor="@color/launcher_text_primary"
                        android:textSize="@dimen/text_body" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="日程事件，辅助反思提醒的上下文"
                        android:textColor="@color/launcher_text_secondary"
                        android:textSize="@dimen/text_small"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
                <Switch
                    android:id="@+id/switch_calendar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

        </LinearLayout>

        <!-- ══════ 系统权限 ══════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/launcher_button_bg"
            android:padding="@dimen/card_padding"
            android:elevation="@dimen/card_elevation"
            android:layout_marginBottom="@dimen/card_margin_bottom">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_lg">

                <View
                    android:layout_width="@dimen/section_indicator_width"
                    android:layout_height="@dimen/section_indicator_height"
                    android:background="@drawable/section_indicator"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="系统权限"
                    android:textColor="@color/launcher_text_primary"
                    android:textSize="@dimen/text_section_title"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_perm_overlay"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="授权悬浮窗权限"
                android:textSize="13sp"
                android:textColor="@color/button_secondary_text"
                android:background="@drawable/button_secondary_bg"
                android:stateListAnimator="@null"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <Button
                android:id="@+id/btn_perm_usage"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="授权使用情况访问"
                android:textSize="13sp"
                android:textColor="@color/button_secondary_text"
                android:background="@drawable/button_secondary_bg"
                android:stateListAnimator="@null"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <Button
                android:id="@+id/btn_start_collection"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="启动 RI4SU 服务"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:background="@drawable/button_primary_bg"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- ══════ 屏幕使用历史 ══════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/launcher_button_bg"
            android:padding="@dimen/card_padding"
            android:elevation="@dimen/card_elevation"
            android:layout_marginBottom="@dimen/card_margin_bottom">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_xs">

                <View
                    android:layout_width="@dimen/section_indicator_width"
                    android:layout_height="@dimen/section_indicator_height"
                    android:background="@drawable/section_indicator"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="反思壁纸历史"
                    android:textColor="@color/launcher_text_primary"
                    android:textSize="@dimen/text_section_title"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="每天生成的反思壁纸记录"
                android:textColor="@color/launcher_text_secondary"
                android:textSize="@dimen/text_caption"
                android:layout_marginStart="13dp"
                android:layout_marginBottom="@dimen/spacing_md" />

            <LinearLayout
                android:id="@+id/history_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- ══════ 开发者测试 ══════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/launcher_button_bg"
            android:padding="@dimen/card_padding"
            android:elevation="@dimen/card_elevation"
            android:layout_marginBottom="48dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_xs">

                <View
                    android:layout_width="@dimen/section_indicator_width"
                    android:layout_height="@dimen/section_indicator_height"
                    android:background="@drawable/section_indicator"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="开发者测试"
                    android:textColor="@color/launcher_text_primary"
                    android:textSize="@dimen/text_section_title"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="调试功能和 Prompt 结构查看"
                android:textColor="@color/launcher_text_secondary"
                android:textSize="@dimen/text_caption"
                android:layout_marginStart="13dp"
                android:layout_marginBottom="@dimen/spacing_lg" />

            <Button
                android:id="@+id/btn_test_data"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="获取当前上下文数据"
                android:textSize="13sp"
                android:textColor="@color/button_secondary_text"
                android:background="@drawable/button_secondary_bg"
                android:stateListAnimator="@null"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <Button
                android:id="@+id/btn_test_ai"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="测试 AI 反思提醒"
                android:textSize="13sp"
                android:textColor="@color/button_secondary_text"
                android:background="@drawable/button_secondary_bg"
                android:stateListAnimator="@null"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <Button
                android:id="@+id/btn_test_wallpaper"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="测试反思壁纸生成"
                android:textSize="13sp"
                android:textColor="@color/button_secondary_text"
                android:background="@drawable/button_secondary_bg"
                android:stateListAnimator="@null"
                android:layout_marginBottom="@dimen/spacing_xs" />

            <TextView
                android:id="@+id/tv_generation_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/launcher_text_secondary"
                android:textSize="@dimen/text_caption"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <Button
                android:id="@+id/btn_test_bubble_prompt"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="查看反思提醒 Prompt 结构"
                android:textSize="13sp"
                android:textColor="@color/button_secondary_text"
                android:background="@drawable/button_secondary_bg"
                android:stateListAnimator="@null"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <Button
                android:id="@+id/btn_test_wallpaper_prompt"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="查看反思壁纸 Prompt 结构"
                android:textSize="13sp"
                android:textColor="@color/button_secondary_text"
                android:background="@drawable/button_secondary_bg"
                android:stateListAnimator="@null"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <TextView
                android:id="@+id/tv_test_output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#5C5A8A"
                android:textSize="@dimen/text_small"
                android:fontFamily="monospace"
                android:background="@drawable/input_bg_rounded"
                android:padding="@dimen/spacing_md"
                android:textIsSelectable="true"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
