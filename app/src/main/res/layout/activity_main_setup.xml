<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1A1A2E"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/header_mood_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/mood_happy" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CATIA3"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_mood_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="数字健康伙伴"
                    android:textColor="#B0B0B0"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Screen time card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/launcher_button_bg"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今日屏幕使用"
                android:textColor="#B0B0B0"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_screen_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tv_mood_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="心情：加载中..."
                android:textColor="#03DAC5"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Floating overlay toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/launcher_button_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="悬浮心情图标"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="始终显示在屏幕上方，反映使用状态"
                    android:textColor="#888888"
                    android:textSize="12sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/switch_overlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <!-- Wallpaper generation toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/launcher_button_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="自动壁纸生成"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="定期根据使用数据生成AI壁纸"
                    android:textColor="#888888"
                    android:textSize="12sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/switch_wallpaper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <!-- Generation interval selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/launcher_button_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="壁纸更新频率"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_interval_30m"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="30分钟"
                    android:textSize="12sp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#3F3F3F"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btn_interval_1h"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="1小时"
                    android:textSize="12sp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#03DAC5"
                    android:textColor="#000000" />

                <Button
                    android:id="@+id/btn_interval_2h"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="2小时"
                    android:textSize="12sp"
                    android:backgroundTint="#3F3F3F"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <!-- Manual generate button -->
        <Button
            android:id="@+id/btn_generate_now"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="立即生成壁纸"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:backgroundTint="#03DAC5"
            android:layout_marginBottom="12dp" />

        <!-- Status text -->
        <TextView
            android:id="@+id/tv_generation_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#B0B0B0"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Permissions section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="权限设置"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_perm_overlay"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="授权悬浮窗权限"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3F3F3F"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_perm_usage"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="授权使用情况访问"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3F3F3F"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_start_collection"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="启动数据收集服务"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3F3F3F"
            android:layout_marginBottom="24dp" />

        <!-- Data management link -->
        <Button
            android:id="@+id/btn_data_management"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="数据收集管理"
            android:textSize="14sp"
            android:textColor="#B0B0B0"
            android:backgroundTint="#2A2A2A"
            android:layout_marginBottom="48dp" />

    </LinearLayout>
</ScrollView>
