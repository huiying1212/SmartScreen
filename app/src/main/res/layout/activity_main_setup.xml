<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/launcher_background"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_xl"
        android:paddingEnd="@dimen/spacing_xl"
        android:paddingTop="48dp"
        android:paddingBottom="32dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- ══════ 顶部品牌区 ══════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RI4SU"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reflective Intervention for Screen Use"
            android:textColor="#B0AECE"
            android:textSize="@dimen/text_subtitle"
            android:letterSpacing="0.02"
            android:layout_marginBottom="@dimen/spacing_xxl" />

        <!-- ══════ AI 提醒（左上/右下引号装饰；引号在下层，正文区域缩进避让对方） ══════ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- 先绘制引号（底层），再绘制正文（上层），避免引号盖住字 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|top"
                android:text="&#x201C;"
                android:textSize="54sp"
                android:textStyle="bold"
                android:textColor="#668B89B8"
                android:includeFontPadding="true"
                android:lineSpacingExtra="0dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|bottom"
                android:text="&#x201D;"
                android:textSize="54sp"
                android:textStyle="bold"
                android:textColor="#668B89B8"
                android:includeFontPadding="true"
                android:lineSpacingExtra="0dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="44dp"
                android:paddingEnd="44dp"
                android:paddingTop="14dp"
                android:paddingBottom="28dp">

                <TextView
                    android:id="@+id/tv_reminder_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="生成中..."
                    android:textColor="@color/launcher_text_secondary"
                    android:textSize="@dimen/text_caption"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <TextView
                    android:id="@+id/tv_reminder_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#5D5B8D"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </FrameLayout>

        <!-- ══════ 功能开关卡片 ══════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/launcher_button_bg"
            android:padding="@dimen/card_padding"
            android:elevation="@dimen/card_elevation"
            android:layout_marginBottom="@dimen/spacing_section">

            <!-- 图标开关 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="52dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="@dimen/spacing_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="反思图标"
                        android:textColor="@color/launcher_text_primary"
                        android:textSize="@dimen/text_section_title"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="悬浮表情随屏幕使用状态实时变化，点击获取 AI 反思提醒"
                        android:textColor="@color/launcher_text_secondary"
                        android:textSize="@dimen/text_caption"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_overlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginBottom="@dimen/spacing_lg" />

            <!-- 壁纸开关 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="52dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="@dimen/spacing_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="反思壁纸"
                        android:textColor="@color/launcher_text_primary"
                        android:textSize="@dimen/text_section_title"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="定时生成 AI 隐喻壁纸，映射你的屏幕使用状态"
                        android:textColor="@color/launcher_text_secondary"
                        android:textSize="@dimen/text_caption"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_wallpaper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- ══════ 设置区 ══════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="@dimen/spacing_md" />

        <!-- 个人设置入口 -->
        <LinearLayout
            android:id="@+id/nav_personal_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/launcher_button_bg"
            android:padding="@dimen/card_padding"
            android:elevation="@dimen/card_elevation"
            android:layout_marginBottom="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="个人设置"
                    android:textColor="@color/launcher_text_primary"
                    android:textSize="@dimen/text_section_title"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="壁纸风格、生成时间、表情风格、个人目标"
                    android:textColor="@color/launcher_text_secondary"
                    android:textSize="@dimen/text_caption"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_right"
                android:contentDescription="进入" />
        </LinearLayout>

        <!-- 系统设置入口 -->
        <LinearLayout
            android:id="@+id/nav_system_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/launcher_button_bg"
            android:padding="@dimen/card_padding"
            android:elevation="@dimen/card_elevation"
            android:layout_marginBottom="48dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="系统设置"
                    android:textColor="@color/launcher_text_primary"
                    android:textSize="@dimen/text_section_title"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="上下文采集、系统权限、壁纸历史、开发者测试"
                    android:textColor="@color/launcher_text_secondary"
                    android:textSize="@dimen/text_caption"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_right"
                android:contentDescription="进入" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
