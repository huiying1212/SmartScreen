<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/launcher_background">

    <!-- 固定顶部栏 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingStart="@dimen/spacing_xl"
        android:paddingEnd="@dimen/spacing_xl"
        android:layout_marginTop="@dimen/spacing_lg"
        android:layout_marginBottom="@dimen/spacing_lg">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/back_button_ripple"
            android:contentDescription="返回"
            android:scaleType="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="个人设置"
            android:textColor="@color/launcher_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_xl"
            android:paddingEnd="@dimen/spacing_xl"
            android:paddingBottom="32dp">

        <!-- ══════ 壁纸风格偏好 ══════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/launcher_button_bg"
            android:padding="@dimen/card_padding"
            android:elevation="@dimen/card_elevation"
            android:layout_marginBottom="@dimen/card_margin_bottom">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_xs">

                <View
                    android:layout_width="@dimen/section_indicator_width"
                    android:layout_height="@dimen/section_indicator_height"
                    android:background="@drawable/section_indicator"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="壁纸风格偏好"
                    android:textColor="@color/launcher_text_primary"
                    android:textSize="@dimen/text_section_title"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选择生成壁纸时的艺术风格"
                android:textColor="@color/launcher_text_secondary"
                android:textSize="@dimen/text_caption"
                android:layout_marginStart="13dp"
                android:layout_marginBottom="@dimen/spacing_md" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/style_chips_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginBottom="@dimen/spacing_lg" />

            <!-- 自动生成时间 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_xs">

                <View
                    android:layout_width="@dimen/section_indicator_width"
                    android:layout_height="@dimen/section_indicator_height"
                    android:background="@drawable/section_indicator"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="自动生成时间"
                    android:textColor="@color/launcher_text_primary"
                    android:textSize="@dimen/text_section_title"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="点击时间可修改，每天在这三个时刻自动生成壁纸"
                android:textColor="@color/launcher_text_secondary"
                android:textSize="@dimen/text_caption"
                android:layout_marginStart="13dp"
                android:layout_marginBottom="@dimen/spacing_lg" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/time_slot_bg"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="上午"
                        android:textColor="@color/launcher_text_secondary"
                        android:textSize="@dimen/text_small" />

                    <TextView
                        android:id="@+id/tv_time_slot_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="08:00"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/time_slot_bg"
                    android:padding="@dimen/spacing_lg"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_marginEnd="@dimen/spacing_sm">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="中午"
                        android:textColor="@color/launcher_text_secondary"
                        android:textSize="@dimen/text_small" />

                    <TextView
                        android:id="@+id/tv_time_slot_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12:00"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/time_slot_bg"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="晚上"
                        android:textColor="@color/launcher_text_secondary"
                        android:textSize="@dimen/text_small" />

                    <TextView
                        android:id="@+id/tv_time_slot_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20:00"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- ══════ 图标风格 ══════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/launcher_button_bg"
            android:padding="@dimen/card_padding"
            android:elevation="@dimen/card_elevation"
            android:layout_marginBottom="@dimen/card_margin_bottom">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_xs">

                <View
                    android:layout_width="@dimen/section_indicator_width"
                    android:layout_height="@dimen/section_indicator_height"
                    android:background="@drawable/section_indicator"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="图标风格"
                    android:textColor="@color/launcher_text_primary"
                    android:textSize="@dimen/text_section_title"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选择悬浮窗表情的视觉风格（表情会随使用状态实时变化）"
                android:textColor="@color/launcher_text_secondary"
                android:textSize="@dimen/text_caption"
                android:layout_marginStart="13dp"
                android:layout_marginBottom="@dimen/spacing_md" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/icon_grid_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- ══════ 个人目标 ══════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/launcher_button_bg"
            android:padding="@dimen/card_padding"
            android:elevation="@dimen/card_elevation"
            android:layout_marginBottom="48dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_xs">

                <View
                    android:layout_width="@dimen/section_indicator_width"
                    android:layout_height="@dimen/section_indicator_height"
                    android:background="@drawable/section_indicator"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="个人目标"
                    android:textColor="@color/launcher_text_primary"
                    android:textSize="@dimen/text_section_title"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="设置你的手机使用目标，AI 会参考你的目标给出更贴切的建议"
                android:textColor="@color/launcher_text_secondary"
                android:textSize="@dimen/text_caption"
                android:layout_marginStart="13dp"
                android:layout_marginBottom="@dimen/spacing_md" />

            <EditText
                android:id="@+id/et_personal_goal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="100dp"
                android:gravity="top|start"
                android:background="@drawable/input_bg_rounded"
                android:padding="@dimen/input_padding"
                android:textColor="@color/launcher_text_primary"
                android:textColorHint="@color/input_hint"
                android:textSize="@dimen/text_body"
                android:hint="例如：\n• 晚上超过十一点一定要睡觉\n• 工作日不要花太多时间刷视频\n• 每天屏幕使用时间尽量不超过七小时\n• 每隔一小时要起身活动一下"
                android:inputType="textMultiLine"
                android:maxLines="8" />

            <Button
                android:id="@+id/btn_save_goal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="保存目标"
                android:textSize="@dimen/button_text_size"
                android:textColor="@color/white"
                android:background="@drawable/button_primary_bg"
                android:stateListAnimator="@null"
                android:layout_marginTop="@dimen/spacing_md" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

</LinearLayout>
