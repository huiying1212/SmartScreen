<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/launcher_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <!-- 顶部栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textColor="#9594c4"
                android:textSize="20sp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="个人设置"
                android:textColor="@color/launcher_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginEnd="36dp" />
        </LinearLayout>

        <!-- 壁纸生成偏好 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/launcher_button_bg"
            android:padding="18dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="16dp"
                    android:background="#c3c2f2"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="壁纸风格偏好"
                    android:textColor="@color/launcher_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选择生成壁纸时的艺术风格"
                android:textColor="@color/launcher_text_secondary"
                android:textSize="12sp"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="12dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/style_chips_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginVertical="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="16dp"
                    android:background="#c3c2f2"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="自动生成时间"
                    android:textColor="@color/launcher_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="点击时间可修改，每天在这三个时刻自动生成壁纸"
                android:textColor="@color/launcher_text_secondary"
                android:textSize="12sp"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@color/theme_accent_tint"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="上午"
                        android:textColor="@color/launcher_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_time_slot_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="08:00"
                        android:textColor="#7B79B2"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@color/theme_accent_tint"
                    android:padding="14dp"
                    android:layout_marginHorizontal="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="中午"
                        android:textColor="@color/launcher_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_time_slot_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12:00"
                        android:textColor="#7B79B2"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@color/theme_accent_tint"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="晚上"
                        android:textColor="@color/launcher_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_time_slot_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20:00"
                        android:textColor="#7B79B2"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- 图标选择 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/launcher_button_bg"
            android:padding="18dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="16dp"
                    android:background="#c3c2f2"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="图标风格"
                    android:textColor="@color/launcher_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选择悬浮窗表情的视觉风格（表情会随使用状态实时变化）"
                android:textColor="@color/launcher_text_secondary"
                android:textSize="12sp"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="12dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/icon_grid_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- 个人目标 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/launcher_button_bg"
            android:padding="18dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="16dp"
                    android:background="#c3c2f2"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="个人目标"
                    android:textColor="@color/launcher_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="设置你的手机使用目标，AI 会参考你的目标给出更贴切的建议"
                android:textColor="@color/launcher_text_secondary"
                android:textSize="12sp"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/et_personal_goal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="100dp"
                android:gravity="top|start"
                android:background="@color/input_bg"
                android:padding="14dp"
                android:textColor="@color/launcher_text_primary"
                android:textColorHint="@color/input_hint"
                android:textSize="14sp"
                android:hint="例如：\n• 晚上超过十一点一定要睡觉\n• 工作日不要花太多时间刷视频\n• 每天屏幕使用时间尽量不超过七小时\n• 每隔一小时要起身活动一下"
                android:inputType="textMultiLine"
                android:maxLines="8" />

            <Button
                android:id="@+id/btn_save_goal"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="保存目标"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#9594c4"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- 结构化使用目标（影响表情变化） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/launcher_button_bg"
            android:padding="18dp"
            android:layout_marginBottom="48dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="16dp"
                    android:background="#c3c2f2"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="使用量化目标"
                    android:textColor="@color/launcher_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="设置量化的使用限制，表情会根据目标达成情况实时变化"
                android:textColor="@color/launcher_text_secondary"
                android:textSize="12sp"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="14dp" />

            <!-- 已设置的目标列表（动态填充） -->
            <LinearLayout
                android:id="@+id/structured_goals_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 空状态提示 -->
            <TextView
                android:id="@+id/tv_goals_empty_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="还没有设置量化目标\n点击下方按钮添加你的第一个目标"
                android:textColor="@color/launcher_text_secondary"
                android:textSize="13sp"
                android:gravity="center"
                android:paddingVertical="16dp"
                android:visibility="gone" />

            <!-- 添加目标按钮 -->
            <Button
                android:id="@+id/btn_add_goal"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="＋ 添加目标"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#9594c4"
                android:layout_marginTop="10dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
